@@ -10335,27 +10396,24 @@ static int tg_check_dl_bandwidth_constraints(struct task_group *tg, void *data)
 	    tg_has_tasks(tg))
 		return -EBUSY;
 
-	total = to_ratio(period, runtime);
-	if (total > BW_UNIT)
-		return -EINVAL;
+	for_each_possible_cpu(cpu) {
+		unsigned long sum = 0;
 
-	list_for_each_entry_rcu(child, &tg->children, siblings) {
