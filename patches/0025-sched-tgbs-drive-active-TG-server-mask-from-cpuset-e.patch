+		list_for_each_entry_rcu(child, &tg->children, siblings) {
+			unsigned long child_bw = tg_schedulable_bw(d, child, cpu);
 
-		child_bw = to_ratio(child_period, child_runtime);
-		if (sum + child_bw < sum)
-			return -EINVAL;
+			if (sum + child_bw < sum)
+				return -EINVAL;
 
-		sum += child_bw;
-		if (sum > total)
-			return -EINVAL;
+			sum += child_bw;
