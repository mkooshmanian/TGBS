 	return to_ratio(period, runtime);
 }
 
+#ifdef CONFIG_ROOT_TG_BANDWIDTH_SERVER
+static unsigned long tg_root_dl_bandwidth_limit(void)
+{
+	if (global_rt_runtime() == RUNTIME_INF)
+		return BW_UNIT;
