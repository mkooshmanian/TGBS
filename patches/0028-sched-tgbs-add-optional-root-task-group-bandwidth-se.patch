 out_free:
 	free_cpumask_var(active_mask);
 	return 0;
@@ -10366,6 +10559,12 @@ static int tg_check_dl_bandwidth_constraints(struct task_group *tg, void *data)
 	int cpu;
 
 	if (tg == &root_task_group) {
