+}
+
+void tg_recalc_root_bandwidth(void)
+{
+	struct task_group *tg = &root_task_group;
+	unsigned long flags;
+	u64 period;
+
+	lockdep_assert_held(&tg_bandwidth_constraints_mutex);
+	if (!tg->tg_server)
